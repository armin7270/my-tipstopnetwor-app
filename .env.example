# Runtime configuration for the production static server (`npm start`).
# This app needs NO secret keys — it never calls a remote API.

# PORT: port used by scripts/serve.mjs (default: 8080)
PORT=8080

# HOST: bind address for scripts/serve.mjs (default: 127.0.0.1, use 0.0.0.0 in containers)
HOST=127.0.0.1

# BASE_PATH: asset base path. Keep "/" for a root domain, or use a sub-path
# such as "/my-repo/" when hosting on GitHub Pages project sites. (build time)
# BASE_PATH=/

# DISABLE_HMR: set to "true" to disable HMR/file watching (used by AI Studio).
# DISABLE_HMR=
