{
  "name": "liquid-obsidian-core",
  "private": true,
  "version": "1.0.0",
  "description": "Liquid Obsidian Core — a networking HUD / proxy-client interface built with React 19, TypeScript, Vite and Tailwind CSS v4.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port=4173 --host=127.0.0.1",
    "start": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "build:android": "vite build --outDir dist-android --base=./",
    "apk": "node scripts/build-apk.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/utils/network-core.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
